// Single-user fork: POST /upload requires UPLOAD_TOKEN; images are served
// publicly and never deleted. Secrets: GithubPAT, GithubOwner, GithubRepo,
// UPLOAD_TOKEN (set with `wrangler secret put`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": {
    "enabled": false
  }
}
